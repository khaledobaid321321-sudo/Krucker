// ============================================================================
// KEY BINDINGS & FLOATING BUTTON
// ============================================================================

window.addEventListener('keyup', function(event) {
	if (x.document.activeElement && x.document.activeElement.value !== undefined) return;

	if (keyToSetting[event.code]) {
		toggleSetting(keyToSetting[event.code]);
	}

	switch (event.code) {
		case 'Slash':
			toggleElementVisibility(gui);
			break;
	}
});

function toggleElementVisibility(el) {
	el.style.display = el.style.display === 'none' ? 'block' : 'none';
}

function toggleSetting(key) {
	if (typeof CheatSettings[key] === 'boolean') {
		CheatSettings[key] = !CheatSettings[key];
	}
}

function fromCamel(text) {
	const result = text.replace(/([A-Z])/g, ' $1');
	return result.charAt(0).toUpperCase() + result.slice(1);
}

function fromHtml(html) {
	const div = document.createElement('div');
	div.innerHTML = html;
	return div.children[0];
}

// Create floating toggle button
window.addEventListener('DOMContentLoaded', function() {
	while (gui.parentElement && gui.parentElement.tagName !== 'BODY') {
		document.body.appendChild(gui.children[0]);
	}
	document.body.appendChild(gui);

	espRenderer.initialize();

	const button = fromHtml(`
		<div id="axiom-menu-button" title="Click to toggle menu">
			⚔️
		</div>
	`);

	document.body.appendChild(button);

	button.addEventListener('click', () => {
		toggleElementVisibility(gui);
	});

	document.getElementById('menu-toggle-btn').addEventListener('click', (e) => {
		e.stopPropagation();
		toggleElementVisibility(gui);
	});

	let isDragging = false;
	let offset = { x: 0, y: 0 };

	button.addEventListener('mousedown', (e) => {
		isDragging = true;
		offset.x = e.clientX - button.offsetLeft;
		offset.y = e.clientY - button.offsetTop;
		button.style.cursor = 'grabbing';
	});

	document.addEventListener('mousemove', (e) => {
		if (!isDragging) return;
		button.style.left = (e.clientX - offset.x) + 'px';
		button.style.top = (e.clientY - offset.y) + 'px';
		button.style.right = 'auto';
		button.style.bottom = 'auto';
	});

	document.addEventListener('mouseup', () => {
		isDragging = false;
		button.style.cursor = 'grab';
	});
});

animate();
