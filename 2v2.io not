// ============================================================================
// ADVANCED AIMBOT ENGINE
// ============================================================================

class AdvancedAimbotEngine {
	constructor() {
		this.targetPlayer = null;
		this.minDistance = Infinity;
		this.lastAimTime = 0;
		this.aimVelocity = new THREE.Vector3();
		this.smoothTarget = new THREE.Vector3();
	}

	findBestTarget() {
		this.targetPlayer = null;
		this.minDistance = Infinity;

		for (let i = 0; i < players.length; i++) {
			const player = players[i];

			if (player.position.x === myPlayer.position.x && 
				player.position.z === myPlayer.position.z) {
				continue;
			}

			const distance = player.position.distanceTo(myPlayer.position);

			// FOV Check
			const screenPos = this.getScreenPosition(player.position);
			if (!screenPos) continue;

			const centerX = window.innerWidth / 2;
			const centerY = window.innerHeight / 2;
			const fovDistance = Math.hypot(screenPos.x - centerX, screenPos.y - centerY);

			if (fovDistance > CheatSettings.aimbotFOV * 20) continue;

			if (distance < this.minDistance) {
				this.targetPlayer = player;
				this.minDistance = distance;
			}
		}

		return this.targetPlayer;
	}

	getTargetPosition() {
		if (!this.targetPlayer) return null;

		let targetPos = this.targetPlayer.position.clone();

		// Target specific limb
		if (this.targetPlayer.children[0]?.children[0]) {
			const headPos = new THREE.Vector3();
			this.targetPlayer.children[0].children[0].localToWorld(headPos);
			
			switch (CheatSettings.aimbotTargetLimbs) {
				case 'head':
					targetPos = headPos;
					break;
				case 'body':
					targetPos.y = this.targetPlayer.position.y + 3;
					break;
				case 'legs':
					targetPos.y = this.targetPlayer.position.y - 2;
					break;
			}
		}

		// Lead prediction
		if (CheatSettings.aimbotLead && this.targetPlayer.velocity) {
			const bulletSpeed = 80;
			const distance = targetPos.distanceTo(myPlayer.position);
			const timeToTarget = distance / bulletSpeed;

			targetPos.x += this.targetPlayer.velocity.x * timeToTarget * 0.12;
			targetPos.y += this.targetPlayer.velocity.y * timeToTarget * 0.12;
			targetPos.z += this.targetPlayer.velocity.z * timeToTarget * 0.12;
		}

		return targetPos;
	}

	calculateAim() {
		if (!this.targetPlayer || !CheatSettings.aimbotEnabled) return;

		const targetPos = this.getTargetPosition();
		if (!targetPos) return;

		// Direction vector
		const direction = new THREE.Vector3().subVectors(targetPos, myPlayer.position);
		direction.normalize();

		// Smooth interpolation
		this.smoothTarget.lerp(direction, CheatSettings.aimbotSmoothing);

		// Apply rotation
		if (myPlayer.children[0]?.rotation) {
			const euler = new THREE.Euler().setFromVector3(this.smoothTarget);
			myPlayer.children[0].rotation.x = -euler.x;
			myPlayer.rotation.y = euler.y + Math.PI;
		}

		// Auto headshot (trigger bot)
		if (CheatSettings.autoHeadshotEnabled || CheatSettings.triggerBotEnabled) {
			if (this.isTargetInCrosshair()) {
				this.triggerShot();
			}
		}
	}

	isTargetInCrosshair() {
		const screenPos = this.getScreenPosition(this.targetPlayer.position);
		if (!screenPos) return false;

		const centerX = window.innerWidth / 2;
		const centerY = window.innerHeight / 2;
		const distance = Math.hypot(screenPos.x - centerX, screenPos.y - centerY);

		return distance < 50;
	}

	triggerShot() {
		const event = new MouseEvent('click', {
			bubbles: true,
			cancelable: true,
			view: window
		});
		document.dispatchEvent(event);
	}

	getScreenPosition(worldPos) {
		try {
			const vector = worldPos.clone();
			const canvas = document.querySelector('canvas');
			if (!canvas || !myPlayer.children[0]?.children[0]) return null;

			vector.project(myPlayer.children[0].children[0]);
			const widthHalf = canvas.clientWidth / 2;
			const heightHalf = canvas.clientHeight / 2;

			return {
				x: vector.x * widthHalf + widthHalf,
				y: -(vector.y) * heightHalf + heightHalf
			};
		} catch (e) {
			return null;
		}
	}
}

const aimbotEngine = new AdvancedAimbotEngine();

// ============================================================================
// ESP RENDERER
// ============================================================================

class ESPRenderer {
	constructor() {
		this.canvas = null;
		this.ctx = null;
	}

	initialize() {
		const canvas = document.createElement('canvas');
		canvas.id = 'axiom-esp-canvas';
		canvas.style.cssText = `
			position: fixed;
			top: 0;
			left: 0;
			z-index: 9997;
			pointer-events: none;
		`;
		canvas.width = window.innerWidth;
		canvas.height = window.innerHeight;
		document.body.appendChild(canvas);

		this.canvas = canvas;
		this.ctx = canvas.getContext('2d');

		window.addEventListener('resize', () => {
			this.canvas.width = window.innerWidth;
			this.canvas.height = window.innerHeight;
		});
	}

	render() {
		if (!CheatSettings.espEnabled || !this.ctx) return;

		this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

		for (let i = 0; i < players.length; i++) {
			const player = players[i];
			this.drawPlayer(player);
		}

		this.drawCrosshair();
	}

	drawPlayer(player) {
		const screenPos = aimbotEngine.getScreenPosition(player.position);
		if (!screenPos) return;

		const boxWidth = 35;
		const boxHeight = 55;
		const x = screenPos.x - boxWidth / 2;
		const y = screenPos.y - boxHeight / 2;

		// Box
		if (CheatSettings.espBoxes) {
			this.ctx.strokeStyle = aimbotEngine.targetPlayer === player ? '#00ff00' : '#ff0080';
			this.ctx.lineWidth = 2;
			this.ctx.strokeRect(x, y, boxWidth, boxHeight);
		}

		// Health bar
		if (CheatSettings.espHealthBars && player.health) {
			const healthPercent = player.health / 100;
			this.ctx.fillStyle = '#ff0000';
			this.ctx.fillRect(x - 8, y, 5, boxHeight);
			this.ctx.fillStyle = '#00ff00';
			this.ctx.fillRect(x - 8, y + (1 - healthPercent) * boxHeight, 5, healthPercent * boxHeight);
		}

		// Distance
		if (CheatSettings.espDistance) {
			const distance = player.position.distanceTo(myPlayer.position).toFixed(1);
			this.ctx.fillStyle = '#00ff00';
			this.ctx.font = 'bold 10px Arial';
			this.ctx.textAlign = 'center';
			this.ctx.fillText(`${distance}m`, screenPos.x, y + boxHeight + 12);
		}
	}

	drawCrosshair() {
		const centerX = window.innerWidth / 2;
		const centerY = window.innerHeight / 2;

		this.ctx.strokeStyle = 'rgba(0, 255, 0, 0.7)';
		this.ctx.lineWidth = 1;

		// Circle
		this.ctx.beginPath();
		this.ctx.arc(centerX, centerY, 12, 0, Math.PI * 2);
		this.ctx.stroke();

		// Cross
		this.ctx.beginPath();
		this.ctx.moveTo(centerX - 25, centerY);
		this.ctx.lineTo(centerX - 12, centerY);
		this.ctx.moveTo(centerX + 12, centerY);
		this.ctx.lineTo(centerX + 25, centerY);
		this.ctx.moveTo(centerX, centerY - 25);
		this.ctx.lineTo(centerX, centerY - 12);
		this.ctx.moveTo(centerX, centerY + 12);
		this.ctx.lineTo(centerX, centerY + 25);
		this.ctx.stroke();
	}
}

const espRenderer = new ESPRenderer();

// ============================================================================
// MAIN ANIMATION LOOP
// ============================================================================

let injectTimer = null;

function animate() {
	x.requestAnimationFrame.call(x.window, animate);

	if (!scene && !injectTimer) {
		const el = x.querySelector.call(x.document, '#loadingBg');
		if (el && el.style.display === 'none') {
			injectTimer = x.setTimeout.call(x.window, () => {
				x.consoleLog('[+] Injecting hooks—fuck yeah');
				x.ArrayPrototype.push = proxied;
			}, 2000);
		}
	}

	players = [];
	myPlayer = null;

	if (!scene) return;

	// Extract players and local player
	for (let i = 0; i < scene.children.length; i++) {
		const child = scene.children[i];

		if (child.type === 'Object3D') {
			try {
				if (child.children[0]?.children[0]?.type === 'PerspectiveCamera') {
					myPlayer = child;
				} else {
					players.push(child);
				}
			} catch (err) {}
		} else if (child.material) {
			child.material.wireframe = CheatSettings.wireframe;
		}
	}

	if (!myPlayer) {
		x.ArrayPrototype.push = proxied;
		return;
	}

	// Process players
	for (let i = 0; i < players.length; i++) {
		const player = players[i];

		if (!player.box) {
			const box = new THREE.LineSegments(geometry, materialRed);
			box.frustumCulled = false;
			player.add(box);
			player.box = box;
		}

		if (player.position.x === myPlayer.position.x && player.position.z === myPlayer.position.z) {
			player.box.visible = false;
			continue;
		}

		player.visible = CheatSettings.wallhackEnabled || player.visible;
		player.box.visible = CheatSettings.espEnabled;
		player.box.material = aimbotEngine.targetPlayer === player ? materialGreen : materialRed;
	}

	// Advanced aimbot
	if (CheatSettings.aimbotEnabled) {
		aimbotEngine.findBestTarget();
		aimbotEngine.calculateAim();
	}

	// ESP rendering
	espRenderer.render();

	// Wallhack
	if (CheatSettings.wallhackEnabled) {
		for (let i = 0; i < scene.children.length; i++) {
			if (scene.children[i].material) {
				scene.children[i].material.transparent = true;
				scene.children[i].material.opacity = 0.3;
			}
		}
	}
}

