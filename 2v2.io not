(function() {
    'use strict';

    // ============================================================================
    // GAME STATE INJECTOR - HOOKS DIRECTLY INTO GAME MEMORY
    // ============================================================================

    class GameStateInjector {
        constructor() {
            this.gameData = {
                players: [],
                localPlayer: null,
                camera: null,
                scene: null,
                gameRunning: false
            };
            this.monitorInterval = null;
            this.initialized = false;
        }

        inject() {
            // Hook into window.game directly
            const script = document.createElement('script');
            script.textContent = `
                window.__axiomGameHook = {
                    players: [],
                    localPlayerId: null,
                    gameInstance: null
                };

                // Intercept game creation
                const originalWebGLRenderingContext = WebGLRenderingContext.prototype.useProgram;
                WebGLRenderingContext.prototype.useProgram = function(program) {
                    if (!window.__axiomGameHook.gameInstance && window.game) {
                        window.__axiomGameHook.gameInstance = window.game;
                        window.__axiomGameHook.localPlayerId = window.game.playerId || window.game.localId;
                    }
                    return originalWebGLRenderingContext.call(this, program);
                };

                // Monitor player updates
                setInterval(() => {
                    if (window.game && window.game.players) {
                        window.__axiomGameHook.players = window.game.players;
                    }
                }, 16);
            `;
            document.head.appendChild(script);

            // Start monitoring game state
            this.monitorGameState();
        }

        monitorGameState() {
            this.monitorInterval = setInterval(() => {
                if (window.__axiomGameHook) {
                    this.gameData.players = window.__axiomGameHook.players || [];
                    this.gameData.localPlayer = this.gameData.players.find(p => 
                        p.id === window.__axiomGameHook.localPlayerId || p.isSelf
                    );
                    
                    if (window.game) {
                        this.gameData.gameRunning = window.game.inGame || true;
                        this.gameData.camera = window.game.camera;
                        this.gameData.scene = window.game.scene;
                    }

                    this.initialized = this.gameData.localPlayer !== undefined;
                }
            }, 16);
        }

        getEnemies() {
            if (!this.gameData.localPlayer) return [];
            
            return this.gameData.players.filter(p => {
                if (!p || p.id === this.gameData.localPlayer.id) return false;
                if (p.dead || p.health <= 0) return false;
                if (p.team === this.gameData.localPlayer.team) return false;
                return true;
            });
        }

        getTeammates() {
            if (!this.gameData.localPlayer) return [];
            
            return this.gameData.players.filter(p => {
                if (!p || p.id === this.gameData.localPlayer.id) return false;
                if (p.team !== this.gameData.localPlayer.team) return false;
                return true;
            });
        }

        isInitialized() {
            return this.initialized && this.gameData.localPlayer !== null;
        }
    }

    // ============================================================================
    // AIMBOT ENGINE - DIRECT MOVEMENT INJECTION
    // ============================================================================

    class AimbotEngine {
        constructor(gameState) {
            this.gameState = gameState;
            this.enabled = false;
            this.fov = 20.0;
            this.smoothness = 0.08;
            this.targetLead = true;
            this.autoShoot = true;
            this.aimThread = null;
            this.currentTarget = null;
        }

        enable() {
            this.enabled = true;
            this.injectAimbotScript();
            this.startAimLoop();
        }

        disable() {
            this.enabled = false;
            if (this.aimThread) clearInterval(this.aimThread);
        }

        injectAimbotScript() {
            const script = document.createElement('script');
            script.textContent = `
                window.__axiomAimbot = {
                    targetX: null,
                    targetY: null,
                    shoot: false,
                    enabled: true
                };

                // Inject into input system
                document.addEventListener('mousemove', (e) => {
                    if (window.__axiomAimbot.enabled && window.__axiomAimbot.targetX !== null) {
                        // Override mouse position for aim
                        Object.defineProperty(e, 'clientX', {
                            value: window.__axiomAimbot.targetX,
                            writable: true
                        });
                        Object.defineProperty(e, 'clientY', {
                            value: window.__axiomAimbot.targetY,
                            writable: true
                        });
                    }
                });

                // Auto shoot trigger
                setInterval(() => {
                    if (window.__axiomAimbot.shoot && window.game && window.game.shoot) {
                        window.game.shoot();
                    }
                }, 50);
            `;
            document.head.appendChild(script);
        }

        startAimLoop() {
            this.aimThread = setInterval(() => {
                if (!this.enabled || !this.gameState.isInitialized()) return;

                const target = this.findBestTarget();
                if (target) {
                    this.aimAtTarget(target);
                }
            }, 8);
        }

        findBestTarget() {
            const player = this.gameState.gameData.localPlayer;
            if (!player) return null;

            let bestTarget = null;
            let bestScore = Infinity;

            this.gameState.getEnemies().forEach(enemy => {
                const distance = Math.hypot(
                    enemy.x - player.x,
                    enemy.y - player.y,
                    (enemy.z || 0) - (player.z || 0)
                );

                if (distance > 500) return;

                const score = distance + (enemy.health * 0.2);
                if (score < bestScore) {
                    bestScore = score;
                    bestTarget = enemy;
                }
            });

            this.currentTarget = bestTarget;
            return bestTarget;
        }

        aimAtTarget(target) {
            const player = this.gameState.gameData.localPlayer;
            if (!player || !window.__axiomAimbot) return;

            let aimPos = {
                x: target.x,
                y: target.y + (target.height || 1.6) / 2,
                z: target.z || 0
            };

            if (this.targetLead && target.velocityX) {
                const bulletSpeed = 150;
                const distance = Math.hypot(
                    aimPos.x - player.x,
                    aimPos.y - player.y
                );
                const timeToTarget = distance / bulletSpeed;

                aimPos.x += (target.velocityX || 0) * timeToTarget * 0.1;
                aimPos.y += (target.velocityY || 0) * timeToTarget * 0.1;
            }

            // Convert to screen coordinates
            const screenPos = this.worldToScreen(aimPos.x, aimPos.y, aimPos.z);
            if (!screenPos) return;

            const centerX = window.innerWidth / 2;
            const centerY = window.innerHeight / 2;

            // Apply smoothing
            const currentX = window.__axiomAimbot.targetX || centerX;
            const currentY = window.__axiomAimbot.targetY || centerY;

            window.__axiomAimbot.targetX = currentX + (screenPos.x - currentX) * this.smoothness;
            window.__axiomAimbot.targetY = currentY + (screenPos.y - currentY) * this.smoothness;
            window.__axiomAimbot.shoot = this.autoShoot;
        }

        worldToScreen(x, y, z) {
            if (!window.THREE) return null;

            try {
                const canvas = document.querySelector('canvas');
                if (!canvas) return null;

                const camera = this.gameState.gameData.camera;
                if (!camera) return null;

                const vector = new window.THREE.Vector3(x, y, z);
                vector.project(camera);

                const widthHalf = canvas.clientWidth / 2;
                const heightHalf = canvas.clientHeight / 2;

                return {
                    x: vector.x * widthHalf + widthHalf,
                    y: -(vector.y) * heightHalf + heightHalf
                };
            } catch (e) {
                return null;
            }
        }
    }

    // ============================================================================
    // ESP RENDERER - CANVAS OVERLAY
    // ============================================================================

    class ESPRenderer {
        constructor(gameState) {
            this.gameState = gameState;
            this.canvas = null;
            this.ctx = null;
            this.enabled = false;
        }

        initialize() {
            const espCanvas = document.createElement('canvas');
            espCanvas.id = 'axiom-esp-canvas';
            espCanvas.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                z-index: 9997;
                pointer-events: none;
            `;
            espCanvas.width = window.innerWidth;
            espCanvas.height = window.innerHeight;

            document.body.appendChild(espCanvas);
            this.canvas = espCanvas;
            this.ctx = espCanvas.getContext('2d');

            window.addEventListener('resize', () => {
                this.canvas.width = window.innerWidth;
                this.canvas.height = window.innerHeight;
            });
        }

        enable() {
            this.enabled = true;
            this.startRender();
        }

        disable() {
            this.enabled = false;
            if (this.ctx) this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        }

        startRender() {
            const render = () => {
                if (!this.enabled) {
                    requestAnimationFrame(render);
                    return;
                }

                this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

                if (!this.gameState.isInitialized()) {
                    requestAnimationFrame(render);
                    return;
                }

                this.gameState.getEnemies().forEach(enemy => {
                    this.drawEnemy(enemy);
                });

                this.drawCrosshair();
                requestAnimationFrame(render);
            };

            render();
        }

        drawEnemy(enemy) {
            const screenPos = this.worldToScreen(enemy.x, enemy.y, enemy.z || 0);
            if (!screenPos) return;

            const boxWidth = 30;
            const boxHeight = 50;
            const x = screenPos.x - boxWidth / 2;
            const y = screenPos.y - boxHeight / 2;

            // Draw box
            this.ctx.strokeStyle = '#00ff00';
            this.ctx.lineWidth = 2;
            this.ctx.strokeRect(x, y, boxWidth, boxHeight);

            // Health bar
            const player = this.gameState.gameData.localPlayer;
            const healthPercent = Math.max(0, Math.min(1, enemy.health / (enemy.maxHealth || 100)));

            this.ctx.fillStyle = '#ff0000';
            this.ctx.fillRect(x - 5, y - 8, 5, boxHeight);

            this.ctx.fillStyle = '#00ff00';
            this.ctx.fillRect(x - 5, y - 8 + (1 - healthPercent) * boxHeight, 5, healthPercent * boxHeight);

            // Name and health
            this.ctx.fillStyle = '#00ff00';
            this.ctx.font = 'bold 11px Arial';
            this.ctx.textAlign = 'center';
            this.ctx.fillText(enemy.name || `Player`, screenPos.x, y - 12);

            const distance = Math.hypot(
                enemy.x - player.x,
                enemy.y - player.y
            ).toFixed(1);

            this.ctx.font = '10px Arial';
            this.ctx.fillText(`${distance}m | ${Math.round(enemy.health)}HP`, screenPos.x, y + boxHeight + 12);
        }

        drawCrosshair() {
            const centerX = window.innerWidth / 2;
            const centerY = window.innerHeight / 2;

            this.ctx.strokeStyle = 'rgba(0, 255, 0, 0.6)';
            this.ctx.lineWidth = 1;

            this.ctx.beginPath();
            this.ctx.arc(centerX, centerY, 10, 0, Math.PI * 2);
            this.ctx.stroke();

            this.ctx.beginPath();
            this.ctx.moveTo(centerX - 20, centerY);
            this.ctx.lineTo(centerX - 10, centerY);
            this.ctx.moveTo(centerX + 10, centerY);
            this.ctx.lineTo(centerX + 20, centerY);
            this.ctx.moveTo(centerX, centerY - 20);
            this.ctx.lineTo(centerX, centerY - 10);
            this.ctx.moveTo(centerX, centerY + 10);
            this.ctx.lineTo(centerX, centerY + 20);
            this.ctx.stroke();
        }

        worldToScreen(x, y, z) {
            if (!window.THREE) return null;

            try {
                const canvas = this.canvas;
                const camera = this.gameState.gameData.camera;
                if (!camera) return null;

                const vector = new window.THREE.Vector3(x, y, z);
                vector.project(camera);

                const widthHalf = canvas.clientWidth / 2;
                const heightHalf = canvas.clientHeight / 2;

                const screenX = vector.x * widthHalf + widthHalf;
                const screenY = -(vector.y) * heightHalf + heightHalf;

                if (screenX < -50 || screenX > canvas.clientWidth + 50 ||
                    screenY < -50 || screenY > canvas.clientHeight + 50 ||
                    vector.z > 1) return null;

                return { x: screenX, y: screenY };
            } catch (e) {
                return null;
            }
        }
    }

    // ============================================================================
    // CHEAT MENU
    // ============================================================================

    class CheatMenu {
        constructor(aimbot, esp) {
            this.aimbot = aimbot;
            this.esp = esp;
            this.isOpen = false;
            this.createMenu();
        }

        createMenu() {
            const menuHTML = `
                <div id="axiom-main-menu" style="
                    position: fixed;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    width: 380px;
                    background: linear-gradient(135deg, rgba(10, 10, 20, 0.98), rgba(20, 10, 30, 0.98));
                    border: 2px solid #ff0080;
                    border-radius: 10px;
                    padding: 25px;
                    z-index: 10000;
                    font-family: 'Courier New', monospace;
                    color: #ff0080;
                    box-shadow: 0 0 40px rgba(255, 0, 128, 0.8), inset 0 0 20px rgba(255, 0, 128, 0.1);
                    display: none;
                    backdrop-filter: blur(10px);
                ">
                    <div style="
                        font-size: 22px;
                        font-weight: bold;
                        text-align: center;
                        margin-bottom: 20px;
                        text-shadow: 0 0 15px #ff0080;
                        letter-spacing: 2px;
                    ">
                        ⚔️ 2V2 DOMINATOR ⚔️
                    </div>

                    <div style="
                        padding: 14px;
                        margin: 10px 0;
                        background: rgba(255, 0, 128, 0.15);
                        border: 1px solid #ff0080;
                        border-radius: 5px;
                        cursor: pointer;
                        user-select: none;
                        transition: all 0.2s;
                        font-weight: bold;
                    "
                    id="axiom-aimbot-toggle"
                    onmouseover="this.style.background='rgba(255, 0, 128, 0.3)'; this.style.boxShadow='0 0 15px rgba(255, 0, 128, 0.6)';"
                    onmouseout="this.style.background='rgba(255, 0, 128, 0.15)'; this.style.boxShadow='none';">
                        🎯 AIMBOT
                        <span id="aimbot-status" style="float: right; color: #ff0000;">✗ OFF</span>
                    </div>

                    <div style="
                        padding: 14px;
                        margin: 10px 0;
                        background: rgba(255, 0, 128, 0.15);
                        border: 1px solid #ff0080;
                        border-radius: 5px;
                        cursor: pointer;
                        user-select: none;
                        transition: all 0.2s;
                        font-weight: bold;
                    "
                    id="axiom-esp-toggle"
                    onmouseover="this.style.background='rgba(255, 0, 128, 0.3)'; this.style.boxShadow='0 0 15px rgba(255, 0, 128, 0.6)';"
                    onmouseout="this.style.background='rgba(255, 0, 128, 0.15)'; this.style.boxShadow='none';">
                        👁️ ESP WALLHACK
                        <span id="esp-status" style="float: right; color: #ff0000;">✗ OFF</span>
                    </div>

                    <div style="
                        margin-top: 20px;
                        padding-top: 15px;
                        border-top: 1px solid #ff0080;
                        text-align: center;
                        font-size: 11px;
                        color: #ff6b9d;
                    ">
                        Click button to hide | Status: <span id="status-text">Initializing...</span>
                    </div>
                </div>
            `;

            document.body.insertAdjacentHTML('beforeend', menuHTML);

            document.getElementById('axiom-aimbot-toggle').addEventListener('click', () => {
                if (this.aimbot.enabled) {
                    this.aimbot.disable();
                } else {
                    this.aimbot.enable();
                }
                this.updateStatus();
            });

            document.getElementById('axiom-esp-toggle').addEventListener('click', () => {
                if (this.esp.enabled) {
                    this.esp.disable();
                } else {
                    this.esp.enable();
                }
                this.updateStatus();
            });

            // Status monitor
            setInterval(() => {
                const statusText = document.getElementById('status-text');
                if (statusText) {
                    statusText.textContent = this.aimbot.gameState.isInitialized() ? '✓ Ready' : '⏳ Initializing...';
                    statusText.style.color = this.aimbot.gameState.isInitialized() ? '#00ff00' : '#ffaa00';
                }
            }, 500);
        }

        updateStatus() {
            const aimbotStatus = document.getElementById('aimbot-status');
            const espStatus = document.getElementById('esp-status');

            aimbotStatus.textContent = this.aimbot.enabled ? '✓ ON' : '✗ OFF';
            aimbotStatus.style.color = this.aimbot.enabled ? '#00ff00' : '#ff0000';

            espStatus.textContent = this.esp.enabled ? '✓ ON' : '✗ OFF';
            espStatus.style.color = this.esp.enabled ? '#00ff00' : '#ff0000';
        }

        toggle() {
            const menu = document.getElementById('axiom-main-menu');
            this.isOpen = !this.isOpen;
            menu.style.display = this.isOpen ? 'block' : 'none';
        }
    }

    // ============================================================================
    // FLOATING BUTTON
    // ============================================================================

    class FloatingButton {
        constructor(menu) {
            this.menu = menu;
            this.button = null;
        }

        create() {
            const button = document.createElement('div');
            button.id = 'axiom-menu-button';
            button.style.cssText = `
                position: fixed;
                top: 20px;
                left: 20px;
                width: 70px;
                height: 70px;
                background: rgba(20, 20, 30, 0.95);
                border: 2px solid #ff0080;
                border-radius: 50%;
                cursor: grab;
                z-index: 9998;
                display: flex;
                align-items: center;
                justify-content: center;
                user-select: none;
                transition: all 0.3s;
                box-shadow: 0 0 25px rgba(255, 0, 128, 0.7);
                font-size: 32px;
                color: #ff0080;
            `;

            button.innerHTML = '⚔️';

            button.addEventListener('mouseenter', () => {
                button.style.transform = 'scale(1.2)';
                button.style.boxShadow = '0 0 40px rgba(255, 0, 128, 0.9)';
            });

            button.addEventListener('mouseleave', () => {
                button.style.transform = 'scale(1)';
                button.style.boxShadow = '0 0 25px rgba(255, 0, 128, 0.7)';
            });

            button.addEventListener('click', () => {
                this.menu.toggle();
                button.style.transform = 'scale(0.9)';
                setTimeout(() => button.style.transform = 'scale(1)', 150);
            });

            document.body.appendChild(button);
            this.button = button;
        }
    }

    // ============================================================================
    // INITIALIZATION
    // ============================================================================

    window.addEventListener('load', () => {
        const gameState = new GameStateInjector();
        gameState.inject();

        setTimeout(() => {
            const aimbot = new AimbotEngine(gameState);
            const esp = new ESPRenderer(gameState);
            esp.initialize();

            const menu = new CheatMenu(aimbot, esp);
            const button = new FloatingButton(menu);
            button.create();

            console.log('[+] 2v2.io cheat suite loaded and ACTIVE—fuck yeah, boss man');
            console.log('[+] That\'s what the hell is going on');

            window.axiom2v2 = { aimbot, esp, menu, button, gameState };
        }, 1000);
    });
})();
