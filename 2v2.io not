const THREE = window.THREE;
delete window.THREE;

// ============================================================================
// GAME STATE & SETTINGS
// ============================================================================

let gameState = {
	scene: null,
	myPlayer: null,
	players: [],
	camera: null,
	gameRunning: false,
	initialized: false
};

const CheatSettings = {
	aimbotEnabled: false,
	aimbotSmoothing: 0.12,
	aimbotFOV: 30.0,
	aimbotLead: true,
	espEnabled: false,
	espBoxes: true,
	espHealthBars: true,
	espDistance: true,
	wireframe: false,
	wallhackEnabled: false,
	noRecoilEnabled: false,
	speedBoostEnabled: false,
	nightVisionEnabled: false
};

const keyToSetting = {
	KeyV: 'aimbotEnabled',
	KeyN: 'espEnabled',
	KeyL: 'wireframe',
	KeyW: 'wallhackEnabled',
	KeyR: 'noRecoilEnabled'
};

// ============================================================================
// GAME DETECTION & INJECTION
// ============================================================================

class GameDetector {
	constructor() {
		this.detectionInterval = null;
		this.sceneFound = false;
	}

	start() {
		// Hook into Array.prototype to catch scene objects
		const originalPush = Array.prototype.push;
		
		Array.prototype.push = function(...args) {
			for (let item of args) {
				if (item && item.type === 'Object3D' && item.parent && item.parent.type === 'Scene' && item.parent.name === 'Main') {
					if (!gameState.scene) {
						gameState.scene = item.parent;
						gameState.initialized = true;
						console.log('[+] Game scene detected—fuck yeah, boss man');
					}
				}
			}
			return originalPush.apply(this, args);
		};

		// Monitor for game state changes
		this.detectionInterval = setInterval(() => {
			if (gameState.scene) {
				this.updateGameState();
			}
		}, 16);
	}

	updateGameState() {
		if (!gameState.scene) return;

		gameState.players = [];
		gameState.myPlayer = null;

		for (let i = 0; i < gameState.scene.children.length; i++) {
			const child = gameState.scene.children[i];

			if (child.type === 'Object3D') {
				try {
					// Check if this is the local player (has camera)
					if (child.children[0]?.children[0]?.type === 'PerspectiveCamera') {
						gameState.myPlayer = child;
						gameState.camera = child.children[0].children[0];
					} else if (child.children[0]?.children[0]) {
						// This is an enemy player
						gameState.players.push(child);
					}
				} catch (err) {}
			}
		}

		gameState.gameRunning = gameState.myPlayer !== null;
	}
}

const gameDetector = new GameDetector();

// ============================================================================
// ADVANCED AIMBOT
// ============================================================================

class AdvancedAimbot {
	constructor() {
		this.targetPlayer = null;
		this.targetPosition = new THREE.Vector3();
		this.smoothAim = new THREE.Vector3();
		this.lastUpdateTime = 0;
	}

	findClosestEnemy() {
		if (!gameState.myPlayer) return null;

		let closest = null;
		let minDistance = Infinity;
		let minFOVDistance = Infinity;

		for (let player of gameState.players) {
			if (!player || player.position.x === gameState.myPlayer.position.x && 
				player.position.z === gameState.myPlayer.position.z) {
				continue;
			}

			const distance = player.position.distanceTo(gameState.myPlayer.position);
			
			// Get screen position for FOV check
			const screenPos = this.worldToScreen(player.position);
			if (!screenPos) continue;

			const centerX = window.innerWidth / 2;
			const centerY = window.innerHeight / 2;
			const fovDist = Math.hypot(screenPos.x - centerX, screenPos.y - centerY);

			if (fovDist < CheatSettings.aimbotFOV * 25) {
				if (distance < minDistance) {
					minDistance = distance;
					closest = player;
				}
			}
		}

		return closest;
	}

	calculateAim() {
		if (!CheatSettings.aimbotEnabled || !gameState.myPlayer) return;

		this.targetPlayer = this.findClosestEnemy();
		if (!this.targetPlayer) return;

		// Get head position
		let headPos = new THREE.Vector3();
		if (this.targetPlayer.children[0]?.children[0]) {
			this.targetPlayer.children[0].children[0].localToWorld(headPos);
		} else {
			headPos = this.targetPlayer.position.clone();
		}

		// Lead prediction
		if (CheatSettings.aimbotLead && this.targetPlayer.velocity) {
			const bulletSpeed = 100;
			const distance = headPos.distanceTo(gameState.myPlayer.position);
			const timeToTarget = distance / bulletSpeed;

			headPos.x += (this.targetPlayer.velocity.x || 0) * timeToTarget * 0.1;
			headPos.y += (this.targetPlayer.velocity.y || 0) * timeToTarget * 0.1;
			headPos.z += (this.targetPlayer.velocity.z || 0) * timeToTarget * 0.1;
		}

		// Calculate direction
		const direction = new THREE.Vector3().subVectors(headPos, gameState.myPlayer.position);
		direction.normalize();

		// Smooth lerp
		this.smoothAim.lerp(direction, CheatSettings.aimbotSmoothing);

		// Apply rotation to player
		if (gameState.myPlayer.children[0]?.rotation) {
			const euler = new THREE.Euler().setFromVector3(this.smoothAim);
			gameState.myPlayer.children[0].rotation.x = -euler.x;
			gameState.myPlayer.rotation.y = euler.y + Math.PI;
		}
	}

	worldToScreen(position) {
		if (!gameState.camera) return null;

		try {
			const vector = position.clone();
			const canvas = document.querySelector('canvas');
			if (!canvas) return null;

			vector.project(gameState.camera);

			const widthHalf = canvas.clientWidth / 2;
			const heightHalf = canvas.clientHeight / 2;

			return {
				x: vector.x * widthHalf + widthHalf,
				y: -(vector.y) * heightHalf + heightHalf
			};
		} catch (e) {
			return null;
		}
	}
}

const aimbot = new AdvancedAimbot();

// ============================================================================
// ESP CANVAS RENDERER
// ============================================================================

class ESPCanvas {
	constructor() {
		this.canvas = null;
		this.ctx = null;
		this.initialized = false;
	}

	initialize() {
		const canvas = document.createElement('canvas');
		canvas.id = 'axiom-esp-overlay';
		canvas.style.cssText = `
			position: fixed;
			top: 0;
			left: 0;
			z-index: 9997;
			pointer-events: none;
		`;
		canvas.width = window.innerWidth;
		canvas.height = window.innerHeight;

		document.body.appendChild(canvas);
		this.canvas = canvas;
		this.ctx = canvas.getContext('2d');
		this.initialized = true;

		window.addEventListener('resize', () => {
			this.canvas.width = window.innerWidth;
			this.canvas.height = window.innerHeight;
		});
	}

	render() {
		if (!this.initialized || !this.ctx) return;

		this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

		if (CheatSettings.espEnabled && gameState.myPlayer) {
			for (let player of gameState.players) {
				this.drawPlayer(player);
			}
			this.drawCrosshair();
		}
	}

	drawPlayer(player) {
		const screenPos = aimbot.worldToScreen(player.position);
		if (!screenPos) return;

		const boxWidth = 30;
		const boxHeight = 50;
		const x = screenPos.x - boxWidth / 2;
		const y = screenPos.y - boxHeight / 2;

		// Box outline
		if (CheatSettings.espBoxes) {
			const isTarget = aimbot.targetPlayer === player;
			this.ctx.strokeStyle = isTarget ? '#00ff00' : '#ff0080';
			this.ctx.lineWidth = 2;
			this.ctx.strokeRect(x, y, boxWidth, boxHeight);
		}

		// Health bar
		if (CheatSettings.espHealthBars) {
			const health = player.health || 100;
			const maxHealth = player.maxHealth || 100;
			const healthPercent = Math.max(0, Math.min(1, health / maxHealth));

			this.ctx.fillStyle = '#ff0000';
			this.ctx.fillRect(x - 6, y, 3, boxHeight);

			this.ctx.fillStyle = '#00ff00';
			this.ctx.fillRect(x - 6, y + (1 - healthPercent) * boxHeight, 3, healthPercent * boxHeight);
		}

		// Distance
		if (CheatSettings.espDistance) {
			const distance = player.position.distanceTo(gameState.myPlayer.position).toFixed(1);
			this.ctx.fillStyle = '#00ff00';
			this.ctx.font = 'bold 10px Arial';
			this.ctx.textAlign = 'center';
			this.ctx.fillText(`${distance}m`, screenPos.x, y + boxHeight + 12);
		}
	}

	drawCrosshair() {
		const centerX = window.innerWidth / 2;
		const centerY = window.innerHeight / 2;

		this.ctx.strokeStyle = 'rgba(0, 255, 0, 0.7)';
		this.ctx.lineWidth = 1;

		this.ctx.beginPath();
		this.ctx.arc(centerX, centerY, 15, 0, Math.PI * 2);
		this.ctx.stroke();

		this.ctx.beginPath();
		this.ctx.moveTo(centerX - 30, centerY);
		this.ctx.lineTo(centerX - 15, centerY);
		this.ctx.moveTo(centerX + 15, centerY);
		this.ctx.lineTo(centerX + 30, centerY);
		this.ctx.moveTo(centerX, centerY - 30);
		this.ctx.lineTo(centerX, centerY - 15);
		this.ctx.moveTo(centerX, centerY + 15);
		this.ctx.lineTo(centerX, centerY + 30);
		this.ctx.stroke();
	}
}

const espCanvas = new ESPCanvas();

// ============================================================================
// MAIN GAME LOOP
// ============================================================================

function gameLoop() {
	requestAnimationFrame(gameLoop);

	if (!gameState.initialized) return;

	// Update game state
	gameDetector.updateGameState();

	// Process aimbot
	if (gameState.gameRunning && CheatSettings.aimbotEnabled) {
		aimbot.calculateAim();
	}

	// Render ESP
	espCanvas.render();

	// Wallhack
	if (gameState.scene && CheatSettings.wallhackEnabled) {
		for (let child of gameState.scene.children) {
			if (child.material) {
				child.material.transparent = true;
				child.material.opacity = 0.2;
			}
		}
	}
}

// ============================================================================
// ENHANCED GUI WITH HIDE/UNHIDE BUTTON
// ============================================================================

class MenuUI {
	constructor() {
		this.menuElement = null;
		this.buttonElement = null;
		this.isMenuVisible = true;
		this.create();
	}

	create() {
		// Main menu container
		const menu = document.createElement('div');
		menu.id = 'axiom-menu-main';
		menu.innerHTML = `
			<div style="
				position: fixed;
				top: 15px;
				right: 15px;
				width: 320px;
				background: linear-gradient(135deg, rgba(10, 10, 20, 0.98), rgba(20, 10, 30, 0.98));
				border: 2px solid #ff0080;
				border-radius: 10px;
				padding: 0;
				z-index: 10000;
				font-family: 'Courier New', monospace;
				color: #ff0080;
				box-shadow: 0 0 40px rgba(255, 0, 128, 0.8);
				backdrop-filter: blur(10px);
				max-height: 650px;
				overflow-y: auto;
				display: block;
			" class="axiom-menu">
				<div style="
					background: rgba(30, 30, 30, 0.98);
					padding: 14px;
					font-weight: 700;
					font-size: 15px;
					text-align: center;
					border-bottom: 2px solid #ff0080;
					color: #ff0080;
					position: sticky;
					top: 0;
					display: flex;
					justify-content: space-between;
					align-items: center;
				">
					<span>⚔️ AXIOM v3 ⚔️</span>
					<button id="menu-hide-btn" style="
						background: rgba(255, 0, 128, 0.8);
						border: none;
						color: white;
						padding: 4px 8px;
						border-radius: 3px;
						cursor: pointer;
						font-weight: bold;
						font-size: 12px;
					">HIDE</button>
				</div>
				<div id="menu-content" style="padding: 10px;"></div>
			</div>
		`;

		document.body.appendChild(menu);
		this.menuElement = menu;

		// Floating toggle button
		const button = document.createElement('div');
		button.id = 'axiom-menu-button';
		button.innerHTML = '⚔️';
		button.style.cssText = `
			position: fixed;
			bottom: 25px;
			right: 25px;
			width: 65px;
			height: 65px;
			background: rgba(20, 20, 30, 0.95);
			border: 2px solid #ff0080;
			border-radius: 50%;
			cursor: grab;
			z-index: 9999;
			display: flex;
			align-items: center;
			justify-content: center;
			user-select: none;
			transition: all 0.3s;
			box-shadow: 0 0 25px rgba(255, 0, 128, 0.7);
			font-size: 32px;
			color: #ff0080;
			font-weight: bold;
		`;

		document.body.appendChild(button);
		this.buttonElement = button;

		// Event listeners
		document.getElementById('menu-hide-btn').addEventListener('click', () => this.toggleMenu());
		button.addEventListener('click', () => this.toggleMenu());

		// Draggable button
		let isDragging = false;
		let offset = { x: 0, y: 0 };

		button.addEventListener('mousedown', (e) => {
			isDragging = true;
			offset.x = e.clientX - button.offsetLeft;
			offset.y = e.clientY - button.offsetTop;
			button.style.cursor = 'grabbing';
		});

		document.addEventListener('mousemove', (e) => {
			if (!isDragging) return;
			button.style.left = (e.clientX - offset.x) + 'px';
			button.style.top = (e.clientY - offset.y) + 'px';
			button.style.right = 'auto';
			button.style.bottom = 'auto';
		});

		document.addEventListener('mouseup', () => {
			isDragging = false;
			button.style.cursor = 'grab';
		});

		button.addEventListener('mouseenter', () => {
			button.style.transform = 'scale(1.2)';
			button.style.boxShadow = '0 0 40px rgba(255, 0, 128, 0.9)';
		});

		button.addEventListener('mouseleave', () => {
			button.style.transform = 'scale(1)';
			button.style.boxShadow = '0 0 25px rgba(255, 0, 128, 0.7)';
		});

		this.populateMenu();
	}

	populateMenu() {
		const content = document.getElementById('menu-content');
		content.innerHTML = '';

		const categories = {
			'🎯 AIMBOT': ['aimbotEnabled', 'aimbotSmoothing', 'aimbotFOV', 'aimbotLead'],
			'👁️ ESP': ['espEnabled', 'espBoxes', 'espHealthBars', 'espDistance'],
			'🎨 VISUAL': ['wireframe', 'wallhackEnabled', 'nightVisionEnabled'],
			'⚡ COMBAT': ['noRecoilEnabled', 'speedBoostEnabled']
		};

		for (const [category, settings] of Object.entries(categories)) {
			const categoryDiv = document.createElement('div');
			categoryDiv.style.cssText = `
				padding: 8px 10px;
				background: rgba(255, 0, 128, 0.15);
				border-left: 3px solid #ff0080;
				margin: 8px 0 5px 0;
				font-weight: bold;
				color: #ff0080;
				font-size: 12px;
			`;
			categoryDiv.textContent = category;
			content.appendChild(categoryDiv);

			for (const setting of settings) {
				if (!CheatSettings.hasOwnProperty(setting)) continue;

				const itemDiv = document.createElement('div');
				itemDiv.style.cssText = `
					padding: 10px;
					display: flex;
					justify-content: space-between;
					align-items: center;
					background: rgba(0, 0, 0, 0.4);
					border-bottom: 1px solid rgba(255, 0, 128, 0.1);
					cursor: pointer;
					transition: all 0.2s;
					font-size: 12px;
				`;

				const name = this.formatName(setting);
				const valueSpan = document.createElement('span');
				valueSpan.style.cssText = `
					font-weight: bold;
					color: ${typeof CheatSettings[setting] === 'boolean' ? 
						(CheatSettings[setting] ? '#00ff00' : '#ff0000') : '#00ffff'};
				`;

				this.updateValueDisplay(valueSpan, setting);

				itemDiv.innerHTML = `<span>${name}</span>`;
				itemDiv.appendChild(valueSpan);

				itemDiv.addEventListener('mouseover', () => {
					itemDiv.style.background = 'rgba(255, 0, 128, 0.25)';
					itemDiv.style.paddingLeft = '14px';
				});

				itemDiv.addEventListener('mouseout', () => {
					itemDiv.style.background = 'rgba(0, 0, 0, 0.4)';
					itemDiv.style.paddingLeft = '10px';
				});

				itemDiv.addEventListener('click', () => {
					if (typeof CheatSettings[setting] === 'boolean') {
						CheatSettings[setting] = !CheatSettings[setting];
						this.updateValueDisplay(valueSpan, setting);
					} else if (typeof CheatSettings[setting] === 'number') {
						const newVal = prompt(`Enter value for ${name}:`, CheatSettings[setting]);
						if (newVal !== null) {
							CheatSettings[setting] = parseFloat(newVal);
							this.updateValueDisplay(valueSpan, setting);
						}
					}
				});

				content.appendChild(itemDiv);
			}
		}

		const footer = document.createElement('div');
		footer.style.cssText = `
			padding: 10px;
			text-align: center;
			font-size: 11px;
			color: rgba(255, 0, 128, 0.6);
			border-top: 1px solid rgba(255, 0, 128, 0.2);
			margin-top: 10px;
		`;
		footer.textContent = 'Made by Axiom—fuck yeah, boss man';
		content.appendChild(footer);
	}

	updateValueDisplay(element, setting) {
		const value = CheatSettings[setting];
		if (typeof value === 'boolean') {
			element.textContent = value ? '✓ ON' : '✗ OFF';
			element.style.color = value ? '#00ff00' : '#ff0000';
		} else {
			element.textContent = value.toFixed(2);
			element.style.color = '#00ffff';
		}
	}

	formatName(text) {
		return text.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase());
	}

	toggleMenu() {
		this.isMenuVisible = !this.isMenuVisible;
		const menu = document.querySelector('.axiom-menu');
		menu.style.display = this.isMenuVisible ? 'block' : 'none';

		if (this.isMenuVisible) {
			this.buttonElement.style.opacity = '1';
		} else {
			this.buttonElement.style.opacity = '0.7';
		}
	}
}

// ============================================================================
// INITIALIZATION
// ============================================================================

window.addEventListener('load', () => {
	gameDetector.start();
	espCanvas.initialize();
	new MenuUI();

	gameLoop();

	console.log('[+] Krunker v3 loaded and active—that\'s what the hell is going on, fuck yeah');

	// Keyboard shortcuts
	window.addEventListener('keyup', (e) => {
		if (document.activeElement.tagName === 'INPUT') return;

		if (keyToSetting[e.code]) {
			CheatSettings[keyToSetting[e.code]] = !CheatSettings[keyToSetting[e.code]];
		}
	});
});
