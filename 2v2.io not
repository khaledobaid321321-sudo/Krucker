function createGUI() {
	const guiEl = fromHtml(`
		<div class="zui" id="axiom-menu">
			<div class="zui-header">
				<span>⚔️ KRUNKER v3 - AXIOM ⚔️</span>
				<button id="menu-toggle-btn" class="menu-close-btn" style="
					position: absolute;
					right: 10px;
					top: 50%;
					transform: translateY(-50%);
					background: rgba(255, 0, 128, 0.8);
					border: none;
					color: white;
					padding: 5px 10px;
					border-radius: 3px;
					cursor: pointer;
					font-weight: bold;
				">✕</button>
			</div>
			<div class="zui-content"></div>
		</div>
	`);

	const contentEl = guiEl.querySelector('.zui-content');

	// Category sections
	const categories = {
		'🎯 AIMBOT': ['aimbotEnabled', 'aimbotSmoothing', 'aimbotFOV', 'aimbotLead', 'aimbotTargetLimbs', 'autoHeadshotEnabled', 'triggerBotEnabled'],
		'👁️ ESP': ['espEnabled', 'espBoxes', 'espHealthBars', 'espDistance', 'espSkeleton'],
		'🎨 VISUAL': ['wireframe', 'nightVisionEnabled', 'wallhackEnabled'],
		'⚡ MOVEMENT': ['speedBoostEnabled', 'speedMultiplier', 'jumpBoostEnabled'],
		'🔧 COMBAT': ['noRecoilEnabled']
	};

	for (const [category, settings] of Object.entries(categories)) {
		const categoryTitle = fromHtml(`<div class="zui-category" style="
			padding: 10px 15px;
			background: rgba(255, 0, 128, 0.2);
			border-left: 3px solid #ff0080;
			margin-top: 5px;
			font-weight: bold;
			color: #ff0080;
		">${category}</div>`);
		contentEl.appendChild(categoryTitle);

		for (const prop of settings) {
			if (!CheatSettings.hasOwnProperty(prop)) continue;

			let name = fromCamel(prop);
			const settingToKey = {};
			for (const key in keyToSetting) {
				settingToKey[keyToSetting[key]] = key;
			}

			let shortKey = settingToKey[prop];
			if (shortKey) {
				if (shortKey.startsWith('Key')) shortKey = shortKey.slice(3);
				name = `[${shortKey}] ${name}`;
			}

			const itemEl = fromHtml(`<div class="zui-item">
				<span>${name}</span>
				<span class="zui-item-value"></span>
			</div>`);
			const valueEl = itemEl.querySelector('.zui-item-value');

			function updateValueEl() {
				const value = CheatSettings[prop];
				if (typeof value === 'boolean') {
					valueEl.innerText = value ? 'ON' : 'OFF';
					valueEl.style.color = value ? '#00ff00' : '#ff0000';
				} else {
					valueEl.innerText = value.toFixed ? value.toFixed(2) : value;
					valueEl.style.color = '#00ffff';
				}
			}

			itemEl.onclick = function() {
				if (typeof CheatSettings[prop] === 'boolean') {
					CheatSettings[prop] = !CheatSettings[prop];
				} else if (typeof CheatSettings[prop] === 'number') {
					const newVal = prompt(`Enter value for ${name}:`, CheatSettings[prop]);
					if (newVal !== null) {
						CheatSettings[prop] = parseFloat(newVal);
					}
				}
			};

			updateValueEl();
			contentEl.appendChild(itemEl);

			const p = `__${prop}`;
			CheatSettings[p] = CheatSettings[prop];
			Object.defineProperty(CheatSettings, prop, {
				get() {
					return this[p];
				},
				set(value) {
					this[p] = value;
					updateValueEl();
				}
			});
		}
	}

	contentEl.appendChild(fromHtml(`<div class="zui-item text">
		<span>Made by Axiom—that's what the hell is going on</span>
	</div>`));

	return guiEl;
}

